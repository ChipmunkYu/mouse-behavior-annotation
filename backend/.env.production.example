# 仅作生成稳定生产环境文件的参考，不要复制到 release 或提交成品。
# CHANGE_ME 是刻意保留的模板占位；production 配置验证会硬拒绝所有占位值。
ENV=production
DATA_DIR=/data/mouse-annotation/data

# 使用密码学安全随机生成器生成足够长的唯一值，禁止提交实际密钥。
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET

# 生成 canonical、无 padding 的 base64url 32-byte secret；不要提交真实值：
# python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode())"
MEDIA_MASTER_SECRET=CHANGE_ME_GENERATE_BASE64URL_32_BYTE_SECRET
MEDIA_TICKET_ENABLED=false
MEDIA_LEGACY_BEARER_ENABLED=true
MEDIA_TICKET_TTL_SECONDS=7200
# Cookie 名、binding Path 及 ticket/binding 的 aud/typ 是代码固定安全契约，不是部署配置。

# 替换为专用生产账号；禁止提交实际用户名和密码。
DEMO_USERNAME=CHANGE_ME_PRODUCTION_USERNAME
DEMO_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD

CORS_ORIGINS=https://jerrylab.xyz
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_SYNCHRONOUS=false
