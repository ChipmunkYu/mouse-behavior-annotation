# 复制为 .env 并修改（.env 已被 gitignore，不会提交）
ENV=development

# 数据目录：数据库、视频、导出片段默认都在其下
DATA_DIR=./data

# 直接指定数据库 URL（可选；默认 sqlite:///<DATA_DIR>/annotation.db）
# DATABASE_URL=sqlite:///./data/annotation.db

# 数据库 schema 由 Alembic 迁移脚本管理（migrations/versions/）：
# - 应用启动时自动执行幂等迁移（全新库建完整 schema；P1 旧库标记 baseline 后升级）；
# - 也可显式运行 .venv\Scripts\python scripts\migrate.py（详见 README「数据库迁移」）。

# JWT 密钥：生产环境必须修改
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# demo 开发账号（仅开发使用，勿用于生产）
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# 允许跨域的前端来源（本地 Vite 开发服务器）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
