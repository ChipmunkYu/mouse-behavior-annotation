# 复制为 .env 并修改（.env 已被 gitignore，不会提交）
ENV=development

# 数据目录：数据库、视频、导出片段默认都在其下
DATA_DIR=./data

# 直接指定数据库 URL（可选；默认 sqlite:///<DATA_DIR>/annotation.db）
# DATABASE_URL=sqlite:///./data/annotation.db

# 数据库 schema 由 Alembic 迁移脚本管理（migrations/versions/）：
# - 应用启动时自动执行幂等迁移（全新库建完整 schema；P1 旧库标记 baseline 后升级）；
# - 也可显式运行 .venv\Scripts\python scripts\migrate.py（详见 README「数据库迁移」）。

# JWT 密钥：生产环境必须修改
SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 原生媒体票据安全默认关闭；legacy Bearer 流保留用于灰度回滚。
MEDIA_TICKET_ENABLED=false
MEDIA_LEGACY_BEARER_ENABLED=true
MEDIA_TICKET_TTL_SECONDS=7200
# 开发占位值：canonical、无 padding 的 base64url（解码 32 bytes）；生产必须替换。
MEDIA_MASTER_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# 固定跨层安全契约（不可通过环境变量自定义）：ticket Cookie=mouse_media_ticket；
# binding Cookie=mouse_media_binding，Path=/api/videos/；JWT aud 分别为
# video-stream / video-stream-binding，typ 分别为 media-ticket / media-binding。

# demo 开发账号（仅开发使用，勿用于生产）
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123

# 允许跨域的前端来源（本地 Vite 开发服务器）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 视频上传：磁盘安全保留空间（字节，默认 1 GiB）。
# 写入前/每块写入前检查 data/videos 可用空间，不足返回 507。
# UPLOAD_DISK_RESERVE_BYTES=1073741824

# 视频上传：分块流式写入的块大小（字节，默认 1 MiB）。
# 应用层不设文件大小上限。
# UPLOAD_CHUNK_SIZE=1048576

# 媒体处理（批次 4：精确片段重编码与缩略图，仅审核通过的视频生成）：
# ffmpeg/ffprobe 可执行文件（默认取 PATH 命令名；本机无 ffmpeg 时可通过它们
# 注入可替换执行器，测试用 FakeMediaProcessor 不要求系统 ffmpeg）。
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# libx264 质量/速度：CRF 越小质量越高体积越大；preset 为速度/体积权衡。
# MEDIA_CRF=23
# MEDIA_PRESET=veryfast

# 单条媒体命令超时（秒），超时清理半成品并判失败。
# MEDIA_TIMEOUT_SECONDS=600

# 片段是否映射音频（true 则 -map 0:a:0? 可选音频 + aac 编码；默认仅视频）。
# MEDIA_MAP_AUDIO=false

# 重启恢复时 running 任务被重排/判失败的 attempts 阈值。
# MEDIA_MAX_ATTEMPTS=3

# 测试用：true 时媒体 worker 在请求线程内同步执行（配合可替换执行器，
# 测试可确定性驱动任务流程；生产保持 false，由单线程后台 worker 串行执行）。
# MEDIA_SYNCHRONOUS=false

# 生命周期清理：启动时执行一次，随后按周期清理过期导出、已知临时文件与任务日志。
# CLEANUP_ENABLED=true
# CLEANUP_INTERVAL_SECONDS=3600
# TEMP_RETENTION_HOURS=24
# JOB_RETENTION_DAYS=30
