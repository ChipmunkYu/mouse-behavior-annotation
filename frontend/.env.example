# 复制为 .env 使用（.env 已被 gitignore）
# 后端 API 根地址（不含 /api 后缀由客户端自动拼接）
VITE_API_BASE=http://localhost:8000/api
# 原生媒体总开关及各页面开关；仅字面值 true 开启。
VITE_NATIVE_MEDIA_ENABLED=false
VITE_NATIVE_MEDIA_PREVIEW_ENABLED=false
VITE_NATIVE_MEDIA_CLIPS_ENABLED=false
VITE_NATIVE_MEDIA_REVIEW_ENABLED=false
VITE_NATIVE_MEDIA_ANNOTATE_ENABLED=false
