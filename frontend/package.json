{
  "name": "annotation-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "多小鼠行为标注网站前端（Vite + React + TypeScript）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "api:generate": "openapi-typescript ../backend/openapi.json -o src/api/generated/schema.d.ts",
    "api:check": "openapi-typescript ../backend/openapi.json -o src/api/generated/schema.d.ts --check",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "test": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "vitest": "3.2.7"
  }
}
