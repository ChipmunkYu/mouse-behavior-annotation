[Unit]
Description=Mouse Annotation API
After=network.target

[Service]
Type=simple
User=jinghan
Group=jinghan
WorkingDirectory=/opt/mouse-annotation/current/backend
EnvironmentFile=/home/jinghan/.config/mouse-annotation/backend.env
ExecStart=/opt/mouse-annotation/current/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
